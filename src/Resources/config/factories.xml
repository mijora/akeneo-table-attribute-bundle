<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
  <services>
    <service id="flagbit_table_attribute.factory.value.table" class="Flagbit\Bundle\TableAttributeBundle\Component\Product\Factory\Value\TableValueFactory"
             public="false">
      <tag name="akeneo.pim.enrichment.factory.product_value"/>
    </service>

    <service id="flagbit_table_attribute.query.get_table_column_codes" class="Flagbit\Bundle\TableAttributeBundle\Query\GetTableColumnCodes"
             public="false">
      <argument type="service" id="database_connection"/>
    </service>

    <service id="flagbit_table_attribute.query.get_table_columns" class="Flagbit\Bundle\TableAttributeBundle\Query\GetTableColumns"
             public="false">
      <argument type="service" id="database_connection"/>
    </service>

    <!-- Brings the table values read from the database to the current columns of their attribute -->
    <service id="flagbit_table_attribute.factory.non_existent_values_filter.table" class="Flagbit\Bundle\TableAttributeBundle\Component\Product\Factory\NonExistentValuesFilter\TableColumnsValuesFilter"
             public="false">
      <argument type="service" id="flagbit_table_attribute.query.get_table_column_codes"/>
      <tag name="akeneo.pim.enrichment.factory.non_existent_values_filter"/>
    </service>
  </services>
</container>
